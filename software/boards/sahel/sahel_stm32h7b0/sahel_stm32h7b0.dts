/dts-v1/;

#include <st/h7/stm32h7b0Xb.dtsi>
#include <st/h7/stm32h7b0vbtx-pinctrl.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>

#include <zephyr/dt-bindings/sensor/lsm9ds1.h>
#include <zephyr/dt-bindings/timer/stm32-timer.h>
/ {

	model = "Sahel STM32H7B0";
	compatible = "custom,sahel-stm32h7b0";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,entropy = &rng;

		zephyr,console = &cdc_acm_uart0;
		zephyr,shell-uart = &cdc_acm_uart0;

		zephyr,canbus = &fdcan1;
	};

	aliases {
    led0 = &green_led;
    led1 = &red_led;
    led2 = &blue_led;
    bus-spi = &spi2;
    bus-i2c = &i2c4;

    imu = &acc_gyro;
    mag = &magnetometer;

    fram = &fram;
		};

	leds {
		compatible = "gpio-leds";

		green_led: led_0 {
			gpios = <&gpioa 1 GPIO_ACTIVE_HIGH>;
		};

		red_led: led_1 {
			gpios = <&gpioa 2 GPIO_ACTIVE_HIGH>;
		};

		blue_led: led_2 {
			gpios = <&gpioa 3 GPIO_ACTIVE_HIGH>;
		};
	};

	uart9: serial@40011800 {
			compatible = "st,stm32-uart";
			reg = <0x40011800 0x400>;
			clocks = <&rcc STM32_CLOCK(APB2, 6)>;
			resets = <&rctl STM32_RESET(APB2, 6)>;
			interrupt-parent = <&nvic>;
			interrupts = <155 0>;
			status = "disabled";
		};	
};


/* -------------------------------------------------------------------------- */
/* CLOCKS / POWER                                                             */
/* -------------------------------------------------------------------------- */

&clk_lsi {
	status = "okay";
};

&clk_hsi48 {
	status = "okay";
};

&clk_hse {
	clock-frequency = <DT_FREQ_M(25)>;
	status = "okay";
};

&pll {
	div-m = <5>;
	mul-n = <112>;

	div-p = <2>;
	div-q = <2>;
	div-r = <2>;

	clocks = <&clk_hse>;

	status = "okay";
};

&rcc {
	clocks = <&pll>;

	clock-frequency = <DT_FREQ_M(280)>;

	d1cpre = <1>;
	hpre = <2>;

	d1ppre = <1>;
	d2ppre1 = <1>;
	d2ppre2 = <1>;
	d3ppre = <1>;
};

&pwr {
	power-supply = "ldo";
};

&rng {
	status = "okay";
};

&backup_sram {
	status = "okay";
};

&iwdg1 {
	status = "okay";
};

/* -------------------------------------------------------------------------- */
/* USB                                                                        */
/* -------------------------------------------------------------------------- */

zephyr_udc0: &usbotg_hs {
	pinctrl-0 = <
		&usb_otg_hs_dm_pa11
		&usb_otg_hs_dp_pa12
	>;

	pinctrl-names = "default";

	status = "okay";
};

#include <../boards/common/usb/cdc_acm_serial.dtsi>

/* -------------------------------------------------------------------------- */
/* SPI                                                                        */
/* -------------------------------------------------------------------------- */

&spi1 {

	pinctrl-0 = <
		&spi1_sck_pa5
		&spi1_miso_pa6
		&spi1_mosi_pa7
	>;

	cs-gpios = <&gpioa 4 GPIO_ACTIVE_LOW>;

	pinctrl-names = "default";

	status = "okay";

	uhf_radio: cc1200@0 {

		compatible = "ti,cc1200";

		reg = <0>;

		spi-max-frequency = <10000000>;

		int-gpios = <&gpioc 5 GPIO_ACTIVE_LOW>;
		//gpio3-gpios = <&gpioc 4 GPIO_ACTIVE_LOW>;

		//frequency = <430000000>;
		//datarate = <12000>;
	};
};

&spi2 {

	pinctrl-0 = <
		&spi2_sck_pb13
		&spi2_miso_pb14
		&spi2_mosi_pb15
	>;

	cs-gpios =
		<&gpiob 12 GPIO_ACTIVE_LOW>,
		<&gpiod 8 GPIO_ACTIVE_LOW>,
		<&gpiod 9 GPIO_ACTIVE_LOW>;

	pinctrl-names = "default";

	status = "okay";
};

&spi4 {

	pinctrl-0 = <
		&spi4_sck_pe12
		&spi4_miso_pe13
		&spi4_mosi_pe14
	>;

	cs-gpios = <&gpioe 11 GPIO_ACTIVE_LOW>;

	pinctrl-names = "default";

	status = "okay";

	vhf_radio: cc1200@0 {

		compatible = "ti,cc1200";

		reg = <0>;

		spi-max-frequency = <10000000>;

		int-gpios = <&gpiob 10 GPIO_ACTIVE_LOW>;
		//gpio3-gpios = <&gpiob 14 GPIO_ACTIVE_LOW>;

		//frequency = <170000000>;
		//datarate = <12000>;

		//status = "okay";
	};
};

/* -------------------------------------------------------------------------- */
/* UART / USART                                                               */
/* -------------------------------------------------------------------------- */

&usart2 {

	pinctrl-0 = <
		&usart2_tx_pd5
		&usart2_rx_pd6
		&usart2_de_pd4
	>;

	pinctrl-names = "default";

	current-speed = <115200>;

	de-enable;

	status = "okay";
};

&uart9 {

	pinctrl-0 = <
		&uart9_tx_pd15
		&uart9_rx_pd14
	>;

	pinctrl-names = "default";

	current-speed = <115200>;

	status = "okay";
};

/* -------------------------------------------------------------------------- */
/* I2C1                                                                       */
/* -------------------------------------------------------------------------- */

&i2c1 {

	pinctrl-0 = <
		&i2c1_scl_pb6
		&i2c1_sda_pb7
	>;

	pinctrl-names = "default";

	clock-frequency = <I2C_BITRATE_FAST>;

	status = "okay";

	thermometer: tmp112@48 {

		compatible = "ti,tmp112";

		reg = <0x48>;
	};

	rtc_ext: rv8803c7@32 {

		compatible = "microcrystal,rv8803";

		reg = <0x32>;
		clkout-frequency = <32768>;
		int-gpios = <&gpiob 5 GPIO_ACTIVE_HIGH>;
		//evi-gpios = <&gpiob 4 GPIO_ACTIVE_HIGH>;
	};

	batt_protect: bq76907@8 {
		compatible = "ti,bq76907";
		reg = <0x08>;

		alert-gpios = <&gpioe 2 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;

		overvoltage-threshold = <4200>;
		undervoltage-threshold = <2500>;
		overcurrent-in-charge-threshold = <2000>;
		overcurrent-in-discharge1-threshold = <3500>;
		overcurrent-in-discharge2-threshold = <3500>;
		number-cell = <2>;
		rsense_mohms= <10>;
	};

	batt_monitor: ina219a@40 {

		compatible = "ti,ina219";

		reg = <0x40>;

		shunt-milliohm = <10>;
		lsb-microamp = <100>;

		status = "okay";
	};
};

/* -------------------------------------------------------------------------- */
/* I2C3                                                                       */
/* -------------------------------------------------------------------------- */

&i2c3 {

	pinctrl-0 = <
		&i2c3_scl_pa8
		&i2c3_sda_pc9
	>;

	pinctrl-names = "default";

	clock-frequency = <I2C_BITRATE_FAST>;

	status = "okay";

	fram: fm24cl64b@50 {
		status = "okay";

		compatible = "infineon,fm24cl64b";

		reg = <0x50>;

		size = <8192>;
		pagesize = <8>;
		address-width = <16>;

		wp-gpios = <&gpioc 6 GPIO_ACTIVE_HIGH>;

	};
};

/* -------------------------------------------------------------------------- */
/* I2C4                                                                       */
/* -------------------------------------------------------------------------- */

&i2c4 {

	pinctrl-0 = <
		&i2c4_scl_pd12
		&i2c4_sda_pd13
	>;

	pinctrl-names = "default";

	clock-frequency = <I2C_BITRATE_FAST>;

	status = "okay";

	acc_gyro: lsm9ds1@6b {

		compatible = "st,lsm9ds1";

		reg = <0x6b>;

		//irq-gpios = <&gpioe 8 GPIO_ACTIVE_HIGH>;
		accel-range = <LSM9DS1_DT_FS_4G>;
		gyro-range = <LSM9DS1_DT_FS_500DPS>;

		imu-odr = <LSM9DS1_GY_OFF_XL_10Hz>;
	};

	magnetometer: lsm9ds1_mag@1e {

		compatible = "st,lsm9ds1-mag";

		reg = <0x1e>;
		mag-range = <LSM9DS1_DT_FS_8Ga>;
		mag-odr = <LSM9DS1_MAG_LP_10Hz>;
		irq-gpios = <&gpioe 7 GPIO_ACTIVE_HIGH>;
	};

	barometer: bmp390@77 {

		compatible = "bosch,bmp388";

		reg = <0x77>;

		int-gpios = <&gpiob 2 GPIO_ACTIVE_HIGH>;

		odr = "12.5";

		osr-press = <8>;
		osr-temp = <1>;

		iir-filter = <3>;
	};

	solar_monitor: ina219a@42 {

		compatible = "ti,ina219";

		reg = <0x42>;

		shunt-milliohm = <10>;
		lsb-microamp = <100>;

		status = "okay";
	};
};

/* -------------------------------------------------------------------------- */
/* CAN                                                                        */
/* -------------------------------------------------------------------------- */

&fdcan1 {

	pinctrl-0 = <
		&fdcan1_rx_pd0
		&fdcan1_tx_pd1
	>;

	status = "okay";

	bitrate = <125000>;
	bitrate-data = <1000000>;

	can_transceiver: tcan334g {

		compatible = "can-transceiver-gpio,ti,tcan334g";

		max-bitrate = <5000000>;
		#phy-cells = <0>;
		standby-gpios = <&gpiod 2 GPIO_ACTIVE_HIGH>;
		enable-gpios = <&gpioa 15 GPIO_ACTIVE_HIGH>;
	};
};

/* -------------------------------------------------------------------------- */
/* TIMERS                                                                     */
/* -------------------------------------------------------------------------- */

&timers2 {

	status = "okay";

	st,prescaler = <4479>;

	st,countermode = <STM32_TIM_COUNTERMODE_UP>;

	counter {
		compatible = "st,stm32-counter";
	};
};